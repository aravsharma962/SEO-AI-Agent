# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude) — reasoning-heavy steps only (see src/lib/anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# DataForSEO — Authority / backlinks module (Part C). Optional: if unset,
# the authority module is skipped and marked "provisional" per spec A9/C.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Voyage AI — embeddings for the semantic proximity module (Claude has no
# embeddings endpoint; Voyage is Anthropic's recommended provider).
# Optional: if unset, semantic proximity is reported as missing_data.
VOYAGE_API_KEY=
